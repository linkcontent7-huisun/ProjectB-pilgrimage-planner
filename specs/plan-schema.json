{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/linkcontent7-huisun/ProjectB-pilgrimage-planner/specs/plan-schema.json",
  "title": "PilgrimagePlan",
  "description": "에이전트가 생성하고 프론트엔드가 렌더링하는 순례 일정. LLM 출력은 반드시 이 스키마를 통과해야 한다.",
  "type": "object",
  "required": ["plan_name", "region", "persona", "party_size", "budget_per_person", "days"],
  "additionalProperties": false,
  "properties": {
    "plan_name": { "type": "string", "minLength": 1 },
    "region": { "type": "string", "description": "예: 대전, 전주, 서울" },
    "persona": {
      "type": "string",
      "enum": ["mass_centered", "walking", "frugal"],
      "description": "mass_centered=미사 참례 중심 / walking=도보 순례 / frugal=짠내 순례"
    },
    "party_size": { "type": "integer", "minimum": 1 },
    "budget_per_person": { "type": "integer", "minimum": 0, "description": "원 단위, 1인 총예산" },
    "estimated_cost_per_person": { "type": "integer", "minimum": 0 },
    "summary": { "type": "string" },
    "days": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["day", "date", "places"],
        "additionalProperties": false,
        "properties": {
          "day": { "type": "integer", "minimum": 1 },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "weather": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "summary": { "type": "string" },
              "temp_min": { "type": "number" },
              "temp_max": { "type": "number" },
              "precipitation_probability": { "type": "number", "minimum": 0, "maximum": 100 }
            }
          },
          "places": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["order", "name", "type", "start_time", "end_time", "coordinates", "description"],
              "additionalProperties": false,
              "properties": {
                "order": { "type": "integer", "minimum": 1 },
                "name": { "type": "string", "minLength": 1 },
                "type": {
                  "type": "string",
                  "enum": ["holy_site", "mass", "restaurant", "cafe", "lodging", "transit", "sight"]
                },
                "start_time": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
                "end_time": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
                "coordinates": {
                  "type": "object",
                  "required": ["lat", "lng"],
                  "additionalProperties": false,
                  "properties": {
                    "lat": { "type": "number", "minimum": 33, "maximum": 39 },
                    "lng": { "type": "number", "minimum": 124, "maximum": 132 }
                  }
                },
                "address": { "type": "string" },
                "description": { "type": "string" },
                "mass_time": { "type": "string", "description": "미사 시간 (holy_site/mass일 때), 예: 11:00" },
                "estimated_cost": { "type": "integer", "minimum": 0 },
                "travel_from_previous": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "mode": { "type": "string", "enum": ["walk", "car", "transit"] },
                    "duration_min": { "type": "integer", "minimum": 0 },
                    "distance_km": { "type": "number", "minimum": 0 }
                  }
                },
                "reason": { "type": "string", "description": "이 장소를 이 순서에 넣은 근거 (의사결정 로그와 연결)" }
              }
            }
          }
        }
      }
    }
  }
}
