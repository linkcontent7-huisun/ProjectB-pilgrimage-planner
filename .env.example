# LLM — 코디세이 공개 API (OpenAI 호환). 콘솔: https://usr.codyssey.kr/daejeon/public-api-console
OPENAI_API_KEY=
OPENAI_BASE_URL=https://copa.codyssey.kr
OPENAI_MODEL=gpt-5-mini

# 지도 — 네이버 클라우드 플랫폼 Maps (Web Dynamic Map + Geocoding + Directions 5)
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# 실시간 검색 — Tavily (https://tavily.com, 무료 1,000회/월)
TAVILY_API_KEY=

# 서버
ALLOWED_ORIGINS=http://localhost:8000
